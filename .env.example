# CityAssist Environment Configuration

# Database (set to 'true' to use PostgreSQL, defaults to SQLite)
USE_POSTGRES=false

# PostgreSQL settings (only used if USE_POSTGRES=true)
DB_NAME=cityassist
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Django settings
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production
OPENAI_API_KEY=your-openai-api-key-here

# Email settings (Gmail SMTP)
# Step 1: Enable 2-Step Verification on the Gmail account.
# Step 2: Go to https://myaccount.google.com/apppasswords
# Step 3: Create an App Password (Mail > Other). Copy the 16-character password.
# Step 4: Paste it as EMAIL_HOST_PASSWORD below.
# NOTE: EMAIL_HOST_USER and DEFAULT_FROM_EMAIL must be the SAME Gmail address.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-gmail-app-password
DEFAULT_FROM_EMAIL=your-gmail-address@gmail.com
SITE_URL=http://localhost:8000